#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source /usr/share/yunohost/helpers
source _common.sh

#=================================================
# LOAD SETTINGS
#=================================================

app=$YNH_APP_INSTANCE_NAME
install_dir=${YNH_APP_INSTALL_DIR:-/var/www/$app}

synapse_instance=${YNH_APP_ARG_SYNAPSE_INSTANCE:-}
botname=${YNH_APP_ARG_BOTNAME:-}
botusers=${YNH_APP_ARG_BOTUSERS:-}
botadmin=${YNH_APP_ARG_BOTADMIN:-}
encryption=${YNH_APP_ARG_ENCRYPTION:-0}
apiid=${YNH_APP_ARG_APIID:-}
apihash=${YNH_APP_ARG_APIHASH:-}
bottoken=${YNH_APP_ARG_BOTTOKEN:-}

#=================================================
# INITIALIZE AND STORE SETTINGS
#=================================================

# SALVA tutte le impostazioni dell'utente
ynh_app_setting_set --key=synapse_instance --value=$synapse_instance
ynh_app_setting_set --key=botname --value=$botname
ynh_app_setting_set --key=botusers --value=$botusers
ynh_app_setting_set --key=botadmin --value=$botadmin
ynh_app_setting_set --key=encryption --value=$encryption
ynh_app_setting_set --key=apiid --value=$apiid
ynh_app_setting_set --key=apihash --value=$apihash
ynh_app_setting_set --key=bottoken --value=$bottoken

# Genera e salva i token
as_token=$(ynh_string_random)
hs_token=$(ynh_string_random)
ynh_app_setting_set --key=as_token --value=$as_token
ynh_app_setting_set --key=hs_token --value=$hs_token

# Recupera i dati del database (impostati automaticamente da YunoHost)
db_name=$(ynh_app_setting_get --key=db_name)
db_user=$db_name  # db_user è uguale a db_name
listen_port=$(ynh_app_setting_get --key=port)

# Salva le impostazioni
ynh_app_setting_set --key=listen_port --value=$listen_port

# Retrieve some values from selected Synapse instance and store them
appserviceid=$app
synapse_install_dir=$(ynh_app_setting_get --app=$synapse_instance --key=install_dir)
server_name=$(ynh_app_setting_get --app=$synapse_instance --key=server_name)
domain=$(ynh_app_setting_get --app=$synapse_instance --key=domain)
ynh_app_setting_set --key=server_name --value=$server_name
ynh_app_setting_set --key=domain --value=$domain
ynh_app_setting_set --key=appserviceid --value=$appserviceid

#=================================================
# SET STANDARD SETTINGS FROM DEFAULT CONFIG
#=================================================

async_media="false"
bot_username="$botname"
bot_displayname="Telegram bridge bot"
bot_avatar="mxc://maunium.net/tJCRmUyJDsgRNgqhOgoiHWbX"
device_model="mautrix-telegram"
ephemeral_events="false"
enable_metrics="false"
alias_template="telegram_{userid}"
displayname_template="{displayname} (Telegram)"
username_template="telegram_{userid}"
delivery_receipts="false"
telegram_link_preview="false"
encryption_default="false"
encryption_require="false"
listrelay="*"
listuser="$botusers"
listadmin="$botadmin"

ynh_app_setting_set --key=appserviceid --value=$appserviceid
ynh_app_setting_set --key=async_media --value=$async_media
ynh_app_setting_set --key=bot_displayname --value=$bot_displayname
ynh_app_setting_set --key=bot_username --value=$bot_username
ynh_app_setting_set --key=bot_avatar --value=$bot_avatar
ynh_app_setting_set --key=device_model --value=$device_model
ynh_app_setting_set --key=ephemeral_events --value=$ephemeral_events
ynh_app_setting_set --key=enable_metrics --value=$enable_metrics
ynh_app_setting_set --key=listen_port --value=$listen_port
ynh_app_setting_set --key=alias_template --value=$alias_template
ynh_app_setting_set --key=displayname_template --value=$displayname_template
ynh_app_setting_set --key=username_template --value=$username_template
ynh_app_setting_set --key=delivery_receipts --value=$delivery_receipts
ynh_app_setting_set --key=telegram_link_preview --value=$telegram_link_preview
ynh_app_setting_set --key=encryption_default --value=$encryption_default
ynh_app_setting_set --key=encryption_require --value=$encryption_require
ynh_app_setting_set --key=listrelay --value=$listrelay
ynh_app_setting_set --key=listuser --value=$listuser
ynh_app_setting_set --key=listadmin --value=$listadmin

#=================================================
# INSTALL SYSTEM DEPENDENCIES
#=================================================
ynh_script_progression "Installing system dependencies..."

# python3-dev, build-essential, libffi-dev, libssl-dev: necessari per compilare moduli python
# libolm-dev: necessario per la crittografia (e2be)
# libjpeg-dev, zlib1g-dev, libwebp-dev: necessari per Pillow (immagini/sticker)
# libmagic1, ffmpeg: necessari per la gestione dei media
ynh_install_app_dependencies python3-dev python3-venv build-essential libolm-dev libffi-dev libssl-dev libjpeg-dev zlib1g-dev libwebp-dev libmagic1 ffmpeg

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir/src"

chmod 750 "$install_dir"
chmod -R 750 "$install_dir"
chown -R $app:$app "$install_dir"

#=================================================
# ADD A CONFIGURATION
#=================================================
ynh_script_progression "Adding $app's configuration..."

# Prepara i valori per la crittografia
is_encryption_enabled="false"
if [ "$encryption" = "true" ] || [ "$encryption" -eq 1 ]; then
  is_encryption_enabled="true"
fi

ynh_add_config --template="../conf/config.yaml" --destination="$install_dir/config.yaml"

# This calls allows to set multiple users during install question "botusers" specifying them separated by a comma
listrelaybot=$listrelay
set__listrelay
set__listuser
set__listadmin

#=================================================
# INSTALL MAUTRIX-BRIDGE PYTHON MODULE
#=================================================
ynh_script_progression "Installing Mautrix-Bridge Python Module..."

mkdir -p /var/log/$app
chown -R $app:$app /var/log/$app

# RIMUOVI il vecchio venv se esiste
rm -rf $install_dir/lib $install_dir/bin $install_dir/include 2>/dev/null || true

# Crea un nuovo venv pulito
python3 -m venv $install_dir
export HOME=$install_dir
chmod -R 750 "$install_dir"
chown -R $app:$app "$install_dir"

# Disabilita cache di pip
export PIP_CACHE_DIR=/dev/null
export PIP_NO_CACHE_DIR=1

# Upgrade pip
$install_dir/bin/pip3 install --upgrade --no-cache-dir pip setuptools wheel

# Installa il package
# Entriamo nella directory src per trovare setup.py, nel caso sia in una sottocartella
pushd "$install_dir/src"

# Cerca la directory che contiene setup.py o pyproject.toml
if [ ! -f "setup.py" ] && [ ! -f "pyproject.toml" ]; then
    # Cerca setup.py O pyproject.toml in una sottocartella
    subdir=$(find . -maxdepth 3 \( -name setup.py -o -name pyproject.toml \) -printf '%h\n' | head -n 1)
    if [ -n "$subdir" ]; then
        cd "$subdir"
        ynh_print_info "Found source in subdirectory: $subdir"
    fi
fi

"$install_dir/bin/pip3" install --no-cache-dir ".[e2be,speedups]"
popd

# Reimposta i permessi dopo l'installazione
chmod -R 750 "$install_dir"
chown -R $app:$app "$install_dir"

#=================================================
# REGISTER SYNAPSE APP-SERVICE
#=================================================
ynh_script_progression "Registering Synapse app-service"

$install_dir/bin/python3 -m mautrix_telegram -g -c $install_dir/config.yaml -r "/etc/matrix-$synapse_instance/app-service/$app.yaml"

# DEBUG: stampa i valori delle variabili
ynh_print_info "DEBUG: synapse_instance = $synapse_instance"
ynh_print_info "DEBUG: synapse_install_dir = $synapse_install_dir"

# Verifica il percorso di Synapse prima di procedere
if [ ! -f "$synapse_install_dir/update_synapse_for_appservice.sh" ]; then
    ynh_print_warn "Can't find script at: $synapse_install_dir/update_synapse_for_appservice.sh"
    ynh_print_info "Trying alternative path: /var/www/synapse/update_synapse_for_appservice.sh"
    
    if [ -f "/var/www/synapse/update_synapse_for_appservice.sh" ]; then
        synapse_install_dir="/var/www/synapse"
        ynh_print_info "Found Synapse at /var/www/synapse"
    else
        ynh_die "Can't find Synapse update script. Searched in: $synapse_install_dir and /var/www/synapse"
    fi
fi

$synapse_install_dir/update_synapse_for_appservice.sh || ynh_die "Synapse can't restart with the appservice configuration"

ynh_store_file_checksum "/etc/matrix-$synapse_instance/app-service/$app.yaml"
ynh_store_file_checksum "$install_dir/config.yaml"

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."


ynh_config_add_systemd

ynh_config_add_logrotate "/var/log/$app/$app.log" $app/$app

yunohost service add $app --description="$app daemon for bridging Telegram and Matrix messages" --log="/var/log/$app/$app.log"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service=$app --action="start"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
